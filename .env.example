# Copy to .env and fill in. Placeholders only; never commit real values.
DOCMIND_ENVIRONMENT=dev
DOCMIND_LOG_LEVEL=INFO
DOCMIND_DEFAULT_TOP_K=10
DOCMIND_MAX_UPLOAD_MB=10
DOCMIND_MAX_PAGES=200
DOCMIND_DEFAULT_MODE=single
DOCMIND_DATABASE_URL=
DOCMIND_DATABASE_URL_DIRECT=
DOCMIND_AUTO_MIGRATE=false
DOCMIND_LLM_PROVIDER=fake
DOCMIND_LLM_BASE_URL=https://api.groq.com/openai/v1
DOCMIND_LLM_MODEL=openai/gpt-oss-120b
DOCMIND_LLM_API_KEY=
DOCMIND_LLM_REASONING_EFFORT=low
DOCMIND_LLM_MAX_COMPLETION_TOKENS=1024
DOCMIND_LLM_MAX_WAIT_SECONDS=20
DOCMIND_HOSTED_RPM=20
DOCMIND_HOSTED_TPM=8000
DOCMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCMIND_MODEL_CACHE_DIR=
DOCMIND_RERANKER_ENABLED=true
DOCMIND_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
DOCMIND_RERANK_CANDIDATES=25
DOCMIND_GIT_SHA=
DOCMIND_UPLOADS_ENABLED=true
DOCMIND_DEMO_DAILY_CAP=300
DOCMIND_DEMO_IP_PER_MIN=5
DOCMIND_TRUST_PROXY_HOPS=0
DOCMIND_GLOBAL_DAILY_LLM_CAP=800
DOCMIND_AUTH_CACHE_SECONDS=60
DOCMIND_KEY_RPM=30
DOCMIND_KEY_DAILY_QUERIES=200
DOCMIND_KEY_MAX_DOCUMENTS=20
DOCMIND_KEY_MAX_PAGES=500
DOCMIND_GUARDRAILS_ENABLED=true
DOCMIND_REQUIRE_CITATION=true
DOCMIND_MAX_ANSWER_CHARS=4000
# Paper corpus: 0.35; demo corpus: 0.52 (evaluation/results/evidence-m6*.json).
DOCMIND_EVIDENCE_MIN_SCORE=0.2
DOCMIND_CACHE_ENABLED=true
# tau from evaluation/results/cache-m6.json (test-half hit rate 0.3636, false-hit 0.0).
DOCMIND_CACHE_THRESHOLD=0.86
DOCMIND_CACHE_TTL_DAYS=30
DOCMIND_QUERY_LOG_DAYS=30
# Secret; protects GET /metrics when set. Unset in prod = endpoint returns 404.
DOCMIND_METRICS_TOKEN=
# Secret; leave empty in the repository.
DOCMIND_CANARY=
